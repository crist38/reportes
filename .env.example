# Copia este archivo a .env (o .env.local). Sin ODOO_URL, ODOO_DB y ODOO_API_KEY la app funciona en modo demo.
# No pongas credenciales reales en este archivo: se sube al repositorio.
ODOO_URL=https://tu-empresa.odoo.com
ODOO_DB=tu-base-de-datos
# Odoo → Preferencias del usuario técnico → Seguridad de la cuenta → Nueva clave API (no la contraseña)
ODOO_API_KEY=

# Campos de selección personalizados en sale.order (Studio o módulo propio)
ODOO_FIELD_TECNICO=x_estado_tecnico
ODOO_FIELD_INSTALACION=x_estado_instalacion

# Máximo de OV confirmadas a leer (las más recientes)
ODOO_LIMIT=300

# Política del flujo
ANTICIPO_PCT=0.5          # fracción cobrada para quedar "Habilitado"
DESPACHO_REQUIERE=pagado  # habilitado | saldo | pagado
